*.bin
*.pt
*.ckpt

# Secrets
.env
.env.local

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# Frontend (see also frontend/.gitignore)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs, except the small fixtures some tests read
*.log
!backend/tests/fixtures/*.log

# OS files
.DS_Store
Thumbs.db

