# Configuration reference.
#
# The backend reads these as ordinary environment variables (set them in your shell before starting
# the server). Only ANTHROPIC_API_KEY is also read from a .env file, and only by the offline
# evaluation scripts. Never commit a real .env file.

# Database. Defaults to psle.db at the repository root. Use an absolute path when overriding.
# For the demo: DATABASE_URL=sqlite:///C:/path/to/repo/demo.db
# DATABASE_URL=

# Language model folder. Defaults to models/phi-4-mini-instruct at the repository root.
# LLM_MODEL_PATH=

# Optional LoRA adapter folder. Unset or empty serves the base model, which is the default because
# the adapter showed no significant improvement (see docs/DATA_AND_EVALUATION.md).
# LLM_ADAPTER_PATH=

# Vision model used for photo transcription. Defaults to Qwen/Qwen3-VL-8B-Instruct.
# VLM_MODEL_ID=

# Optional, paid. Used only by scripts/evaluation/hint_quality/ for the blind hint-quality judge.
# The app itself never calls this API.
ANTHROPIC_API_KEY=

# Frontend: backend address, if it is not http://localhost:8000.
# NEXT_PUBLIC_API_BASE_URL=
